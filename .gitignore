# ==============================================================================
# MIND2I Workshop & Bootcamp Hub - Git Ignore Rules
# ==============================================================================

# Node / Frontend Dependencies & Builds
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Python / Django Dependencies & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Django Media & Database
*.sqlite3
*.db
backend/media/*
!backend/media/.gitkeep

# Environment Files (Keep .env.example tracked)
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
.swp
.swo
*~

# Coverage and Test Output
coverage/
.nyc_output/
