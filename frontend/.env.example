# ==============================================================================
# Frontend Environment Template (frontend/.env)
# ==============================================================================

# Google Gemini AI API key for document analysis & AI question generation
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# App URL where this web app is accessible
APP_URL=http://localhost:3000

# Server Listening Port
PORT=3000

# Django Backend API Base URL
DJANGO_BACKEND_URL=http://127.0.0.1:8000
