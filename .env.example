# ==============================================================================
# MIND2I Workshop & Bootcamp Hub - Root Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Configuration (Place in frontend/.env)
# ------------------------------------------------------------------------------
# Google Gemini AI API key (get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# App URL where the frontend is accessible
APP_URL=http://localhost:3000

# Express server listening port
PORT=3000

# Django Backend API URL
DJANGO_BACKEND_URL=http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# Backend Environment Configuration (Place in backend/.env)
# ------------------------------------------------------------------------------
# Django secret key for session signing and security
SECRET_KEY=django-insecure-mind2i-workshop-bootcamp-secret-key-change-in-production

# Enable debug mode for development (set to False in production)
DEBUG=True

# Database Configuration (Defaults to SQLite if PostgreSQL credentials are left blank)
DB_NAME=mind2i_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Default Admin Credentials
ADMIN_USERNAME=admin@mind2i.edu
ADMIN_PASSWORD=mind2i@admin
